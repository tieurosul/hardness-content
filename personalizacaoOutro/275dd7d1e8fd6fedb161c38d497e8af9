/**
 * Normaliza PDF para 1.4 usando Ghostscript e registra saída/erros.
 * Usa -dNOSAFER para evitar bloqueio de acesso a arquivos (invalidfileaccess) em ambientes com sandbox.
 */
function normalizaPdfPara14($arquivoOriginal) {
    $arquivoSaida = preg_replace('/\.pdf$/i', '', $arquivoOriginal) . '_v14.pdf';

    // Valida existência do arquivo de entrada
    if (!file_exists($arquivoOriginal)) {
        log("NORMALIZA: PDF NAO EXISTE: ".$arquivoOriginal);
        return $arquivoOriginal;
    }

    $cmd = "gs -dNOSAFER -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -dNOPAUSE -dBATCH " .
           "-sOutputFile=" . escapeshellarg($arquivoSaida) . " " . escapeshellarg($arquivoOriginal) . " 2>&1";

    $out = shell_exec($cmd);
    log("NORMALIZA GS OUT {$arquivoOriginal}:\n".$out);

    // Confere se gerou arquivo válido
    if (file_exists($arquivoSaida) && filesize($arquivoSaida) > 1000) {
        return $arquivoSaida;
    }

    log("NORMALIZA: FALHOU (saida nao criada ou muito pequena): ".$arquivoSaida);
    // Se der erro, volta o original (ou trate como quiser)
    return $arquivoOriginal;
}

