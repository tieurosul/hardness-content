    LEFT JOIN D004 ON D004_Id = T066_D004_Id
    LEFT JOIN D009 ON D009_Id = T066_D009_Id
    LEFT JOIN D049 ON D049_Id = D009_D049_Id
    LEFT JOIN D001 ON D001_Id = D049_D001_Id
    LEFT JOIN T066A ON T066_Id = T066A_T066_Id
