<?php
namespace hardness;

function callback($array, $params = null) {
    // seu código
    // $array['campoAtual']
    // $array['todosCampos']['Teste Status Entrega']
    // $array['totais']['Nome_Total']

    $sql = "SELECT T007_Data_Entrega, IFNULL(T007A_Data_Prazo_Transporte, {$array['todosCampos']['T005A_Data_Agendamento']}) as Prazo_Entrega,
            CASE 
                WHEN 
                    Prazo_Entrega = '0000-00-00'OR
                    T007_Data_Entrega = '0000-00-00' OR
                    Prazo_Entrega IS NULL OR
                    T007_Data_Entrega IS NULL
                THEN '-'
                WHEN T007_Data_Entrega <= Prazo_Entrega
                THEN 'DENTRO DO PRAZO'
                ELSE 'FORA DO PRAZO'
            END as Status_Prazo
            FROM T007 LEFT JOIN T007A ON T007A_T007_Id=T007_Id
            WHERE T007_Id = '{$array['todosCampos']['T007_Id']}'";
    $sql = mysql_query($sql);
    $sql = mysql_fetch_array($sql);

    if ($sql['Status_Prazo'] == 'FORA DO PRAZO') {
        return "<span style='color: red;'>FORA DO PRAZO</span>";
    } else {
        return $sql['Status_Prazo'];
    }
}