function etiquetaDespacho(T007_Id) {
    $.ajax({
        url: '/sistema/personalizacaoLowCode/grid_func-ajax/telaGerarPdf/',
        type: 'GET',
        dataType: 'jsonp',
        data: {
            'ajax': 'true',
            'acaoId': '7c26aa4c8fb14f00fbf2ebb77d6c8aaa',
            'link': '/sistema/personalizacao/tela/7c26aa4c8fb14f00fbf2ebb77d6c8aaa/?ajax=true&T007_Id=' + T007_Id,
        },
        success: function(resposta) {
            $('#[[divId]]').hideLoading();
            window.open(resposta.data, '_blank');
        }
    });
}