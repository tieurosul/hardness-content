    LEFT JOIN D049 ON D049_Id=D009_D049_Id 
    LEFT JOIN D001 ON D001_Id=D049_D001_Id
WHERE 
	D009_Preco_1 > 0
    AND ((D009_Preco_3 != ROUND((D009_Preco_1*D009_IPT_3),10) AND D009_IPT_3 > 0)
    OR (D009_Preco_4 != ROUND((D009_Preco_1*D009_IPT_4),10) AND D009_IPT_4 > 0))
    AND (D001_Flag_Ativo != 'N' OR D001_Flag_Ativo IS NULL)
GROUP BY D009_Id 