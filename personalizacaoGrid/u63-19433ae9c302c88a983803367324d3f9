colunaValor [CASE 
    WHEN COUNT(DISTINCT T007_Numero_Nota_Fiscal) > 5 THEN 
        CONCAT(
            SUBSTRING_INDEX(
                GROUP_CONCAT(DISTINCT T007_Numero_Nota_Fiscal ORDER BY T007_Numero_Nota_Fiscal SEPARATOR ', '),
                ', ',
                5
            ),
            ', ...'
        )
    ELSE 
        GROUP_CONCAT(DISTINCT T007_Numero_Nota_Fiscal ORDER BY T007_Numero_Nota_Fiscal SEPARATOR ', ')
END]
