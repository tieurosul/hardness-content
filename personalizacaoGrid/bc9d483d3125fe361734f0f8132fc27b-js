    opcaoEtiquetaLote(array['todosCampos']['D009_Id'],array['todosCampos']['T066_Id']);
});

function opcaoEtiquetaLote(D009_Id, T066_Id){
    var $buttons = {
        "Lote 100x40": function() {
            imprimirEtiquetaLote('f351afb5493fc6f950d0afab54408e98', D009_Id, T066_Id);
            $(this).dialog("destroy").remove(); 
        },
        "Cancelar": function() { 
            $(this).dialog("destroy").remove(); 
        }
    };
    dialogConfirm('Etiqueta', 'Escolha o tamanho da etiqueta', $buttons);
}

function imprimirEtiquetaLote(modelo, D009_Id, T066_Id) {
    $('#[[divId]]').showLoading();
    $.ajax({
        url: '/sistema/personalizacaoLowCode/grid_func-ajax/telaGerarPdf/',
        type: 'GET',
        dataType: 'jsonp',
        data: {
            'ajax': 'true',
            'acaoId': modelo,
            'link': '/sistema/personalizacao/tela/'+ modelo +'/?ajax=true&D009_Id=' + D009_Id + '&T066_Id=' + T066_Id,
        },
        success: function(resposta) {
            $('#[[divId]]').hideLoading();
            window.open(resposta.data, '_blank');
        }
    });
}